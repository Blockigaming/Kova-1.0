{
  "name": "kova-model",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "validate:stack": "node scripts/validate-stack.mjs",
    "dataset:compile": "node scripts/compile-dataset.mjs",
    "training:command": "node scripts/training-command.mjs",
    "training:execute": "node scripts/training-command.mjs --execute",
    "pricing:floor": "node scripts/price-floor.mjs",
    "benchmark:summarize": "node scripts/summarize-benchmark.mjs",
    "benchmark:core:summarize": "node scripts/summarize-core-benchmark.mjs",
    "evaluate:offline": "python3 -m evaluation.offline",
    "preflight": "npm run validate:data && npm run validate:stack && npm run evaluate:offline",
    "test": "node --test tests/*.test.mjs && python3 -m unittest worker.test_handler router.test_policy router.test_auto core.test_adapter ultra.test_orchestrator evaluation.test_offline"
  }
}
